# Copy to .env (or .env.local) and fill in real values. Never commit real secrets.

# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/careersence?schema=public"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── AI providers ────────────────────────────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Optional integrations ───────────────────────────────────────────────────
RAPIDAPI_KEY=     # JSearch job search
YOUTUBE_API=      # learning resources
DEV_API=          # dev.to articles

# ── Optional bootstrap admin ────────────────────────────────────────────────
# There are NO default admin credentials. Leave blank to disable; admins can
# also be granted by setting User.isAdmin = true in the database.
ADMIN_EMAIL=
ADMIN_PASSWORD=
